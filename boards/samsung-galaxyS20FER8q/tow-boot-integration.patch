diff --git a/board/qualcomm/qcom-phone.env b/board/qualcomm/qcom-phone.env
index be0d80a..35977b8 100644
--- a/board/qualcomm/qcom-phone.env
+++ b/board/qualcomm/qcom-phone.env
@@ -1,4 +1,5 @@
-bootdelay=0
+board_identifier=@boardIdentifier@
+bootdelay=2
 bootretry=1
 stdin=serial,button-kbd
 stdout=serial,vidconsole
@@ -16,7 +17,7 @@ serial_gadget=setenv stdin serial,button-kbd,usbacm; \
 	setenv stdout serial,vidconsole,usbacm; \
 	setenv stderr serial,vidconsole,usbacm; \
 	setenv bootretry -1; \
-	echo Enabled U-Boot console serial gadget
+	echo Enabled Tow-Boot console serial gadget
 
 # bootretry will run this command over and over, if we fail once
 # then bail out to the boot menu instead (with a pause to read
@@ -26,21 +27,26 @@ bootcmd=bootefi bootmgr; pause; run menucmd
 # When entering the menu (either from button press or failed boot)
 # remap bootcmd so it will re-open the menu and we won't get stuck
 # at the console with no way to type
-menucmd=setenv bootcmd run menucmd; bootmenu -1
+menucmd=setenv bootcmd run menucmd; run towboot_menu
 
 # Pause is used so the output can be read on the display
-bootmenu_0=Boot=bootefi bootmgr; pause
-bootmenu_1=Enable serial console gadget=run serial_gadget
-bootmenu_2=Enable USB mass storage=echo "Press any key to exit UMS mode"; ums 0 scsi 0
-bootmenu_3=Enable fastboot mode=echo "Press any key to exit fastboot mode"; run fastboot
-# Disabling bootretry means we'll just drop the shell
-bootmenu_4=Drop to shell=setenv bootretry -1
-bootmenu_5=Reset device=reset
-bootmenu_6=Dump clocks=clk dump; pause
-bootmenu_7=Dump environment=printenv; pause
-bootmenu_8=Board info=bdinfo; pause
-bootmenu_9=Dump bootargs=fdt addr $fdt_addr_r; fdt print /chosen bootargs; pause
-bootmenu_10=Power off=poweroff
+towboot_menu=tb_menu new; \
+	tb_menu add 'Boot' 'Start the EFI boot manager' 'bootefi bootmgr; pause; run menucmd'; \
+	tb_menu add 'Scan boot devices' 'Find and boot operating systems' 'bootflow scan -b; pause; run menucmd'; \
+	tb_menu separator; \
+	tb_menu add 'USB serial console' 'Enable the USB console' 'run serial_gadget; run menucmd'; \
+	tb_menu add 'USB mass storage' 'Expose internal UFS over USB' 'echo Press any key to exit; ums 0 scsi 0; run menucmd'; \
+	tb_menu add 'Fastboot' 'Start USB fastboot mode' 'run fastboot; run menucmd'; \
+	tb_menu add 'Firmware Console' 'Exit to the command line' 'setenv bootretry -1; cls; echo Use run menucmd to return'; \
+	tb_menu separator; \
+	tb_menu add 'Dump clocks' 'Display clock information' 'clk dump; pause; run menucmd'; \
+	tb_menu add 'Dump environment' 'Display firmware variables' 'printenv; pause; run menucmd'; \
+	tb_menu add 'Board info' 'Display board information' 'bdinfo; pause; run menucmd'; \
+	tb_menu add 'Dump bootargs' 'Display kernel arguments' 'fdt addr $fdt_addr_r; fdt print /chosen bootargs; pause; run menucmd'; \
+	tb_menu separator; \
+	tb_menu add 'Reboot' 'Restart the device' 'reset'; \
+	tb_menu add 'Shutdown' 'Power off the device' 'poweroff'; \
+	tb_menu show
 
 # Allow holding the volume down button while U-Boot loads to enter
 # the boot menu
